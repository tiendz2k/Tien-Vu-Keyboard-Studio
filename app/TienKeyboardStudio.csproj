<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TienKeyboardStudio</AssemblyName>
    <RootNamespace>TienKeyboardStudio3</RootNamespace>
    <Product>T Keyboard Studio</Product>
    <AssemblyTitle>T Keyboard Studio</AssemblyTitle>
    <Description>T Keyboard Studio 3.6.0 — ứng dụng điều khiển bàn phím (AULA F75 Max hỗ trợ đầy đủ; các model khác xem trước). Giao diện Liquid Glass + hình nền + màn hình chào + Chợ plugin + GameSense CS2 (GSI). Driver Pack 1: họ Sinowealth kb_by_v2 (định danh UUID 0x82 trước khi ghi). Driver Pack 2: nền tảng RongYuan (định danh dev_id 0x8F). Driver Pack 3: họ MCHOSE (stack GLW/CZ + QHW, định danh PID registry + probe đọc). Dry-run bật mặc định.</Description>
    <Version>3.6.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.9" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9" />
    <PackageReference Include="HidSharp" Version="2.1.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <!-- Font Be Vietnam Pro (SIL OFL 1.1) + logo + GIF tich hop + manifest: nhung thang vao exe -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Assets\Fonts\OFL.txt" />
    <AvaloniaResource Include="Assets\logo.png" />
    <AvaloniaResource Include="Assets\Gifs\**\*.gif" />
    <AvaloniaResource Include="Assets\effects-manifest.json" />
    <!-- v3.3: skin hinh nen + anh bia Cho plugin (lay tu Preview v0.10.1 da duyet) -->
    <AvaloniaResource Include="Assets\Wallpapers\*.jpg" />
    <AvaloniaResource Include="Assets\Plugins\*.png" />
  </ItemGroup>

  <!-- Catalog Thu vien Online (16 hieu ung cong dong DONG GOI SAN, v3.2.2):
       chi ten + ten file local, file GIF nam o thu muc OnlineLibrary canh exe -->
  <ItemGroup>
    <EmbeddedResource Include="online-catalog.json">
      <LogicalName>TienKeyboardStudio32.online-catalog.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Thu muc OnlineLibrary (16 GIF goc dang dai LED rong) nam canh exe sau khi publish -->
  <ItemGroup>
    <Content Include="..\OnlineLibrary\**\*.gif">
      <Link>OnlineLibrary\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\OnlineLibrary\**\*.png">
      <Link>OnlineLibrary\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- Thu muc Library (21 GIF) nam canh exe sau khi publish, giong v3.1 -->
  <ItemGroup>
    <Content Include="..\Library\**\*.gif">
      <Link>Library\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\Library\**\*.md">
      <Link>Library\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
