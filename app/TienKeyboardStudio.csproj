<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TienKeyboardStudio</AssemblyName>
    <RootNamespace>TienKeyboardStudio3</RootNamespace>
    <Product>Tien Vu Keyboard Studio</Product>
    <AssemblyTitle>Tien Vu Keyboard Studio</AssemblyTitle>
    <Company>tiendz2k</Company>
    <Authors>tiendz2k</Authors>
    <Copyright>© 2026 Vũ Minh Tiến (tiendz2k)</Copyright>
    <Description>Tien Vu Keyboard Studio 3.10.0 — ứng dụng điều khiển bàn phím (AULA F75 Max hỗ trợ đầy đủ; các model khác xem trước). Giao diện Liquid Glass + hình nền + màn hình chào + Chợ plugin + GameSense CS2 (GSI). Driver Pack 1: họ Sinowealth kb_by_v2 (định danh UUID 0x82 trước khi ghi). Driver Pack 2: nền tảng RongYuan (định danh dev_id 0x8F). Driver Pack 3: họ MCHOSE (stack GLW/CZ + QHW, định danh PID registry + probe đọc). Driver Pack 4: họ SONiX anh em (S75 Pro/Nova75, MAD60, HERO68 HE, WIN60 HE/SE) + nền WitMod (Redragon K617 HE, định danh probe 0x0D/0x01) + sao chép thông tin thiết bị và cập nhật bảng thiết bị cộng đồng. v3.8: đổi tên Tien Vu Keyboard Studio + logo mới, chữ ký tác giả + kiểm tra toàn vẹn, Thư viện Online chuyển sang tải theo nhu cầu từ Google Drive (bản cài nhẹ), thêm GIF từ link TikTok (thử nghiệm), sửa RAM lưới GIF. Driver Pack 5: họ DareU (TG/TG-RT + Magnetic Axis, OHID, JM/QF — registry web driver chính hãng) + họ AULA Hub còn lại (HFD, SparkLink V1/V2 — registry VID:PID + usage page). v3.9.1: panel nhật ký thao tác ẩn mặc định, bật lại trong Cài đặt app (chỉ thay đổi hiển thị). v3.9.2: stream GIF→LED của F75 Max viết lại theo cơ chế ứng dụng tham chiếu cùng nền tảng SONiX (bắt tay 0xF5, ACK poll/gửi lại, pacer 2 ms, chọn interface 0xFF13, lấy mẫu median + blackLevel 24 + sửa hệ toạ độ) — chưa kiểm chứng trên F75 Max thật. v3.10: 4 theme màn hình chào mới trong Chợ plugin (550C Boot + Thẻ ID có QR thật, DeepSeek Harness — Rhine Lab bản đầy đủ 6 hồi, MOSS · Ignition tái hiện phong cách vẽ thủ tục, Hạt Bụi TV 3.200 hạt tụ thành logo Mẫu F) + khối ghi công MIT. Dry-run bật mặc định.</Description>
    <Version>3.10.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.9" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9" />
    <PackageReference Include="HidSharp" Version="2.1.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <!-- Font Be Vietnam Pro (SIL OFL 1.1) + logo + GIF tich hop + manifest: nhung thang vao exe -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Assets\Fonts\OFL.txt" />
    <AvaloniaResource Include="Assets\logo.png" />
    <AvaloniaResource Include="Assets\Gifs\**\*.gif" />
    <AvaloniaResource Include="Assets\effects-manifest.json" />
    <!-- v3.3: skin hinh nen + anh bia Cho plugin (lay tu Preview v0.10.1 da duyet) -->
    <AvaloniaResource Include="Assets\Wallpapers\*.jpg" />
    <AvaloniaResource Include="Assets\Plugins\*.png" />
  </ItemGroup>

  <!-- Catalog Thu vien Online (16 hieu ung cong dong DONG GOI SAN, v3.2.2):
       chi ten + ten file local, file GIF nam o thu muc OnlineLibrary canh exe -->
  <ItemGroup>
    <EmbeddedResource Include="online-catalog.json">
      <LogicalName>TienKeyboardStudio32.online-catalog.json</LogicalName>
    </EmbeddedResource>
    <!-- v3.8: bang bam toan ven, sinh boi build.sh truoc khi publish -->
    <EmbeddedResource Include="integrity-manifest.json">
      <LogicalName>TienKeyboardStudio38.integrity-manifest.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- v3.8 BAN GON: OnlineLibrary chi con thumb PNG nho dong goi san.
       GIF goc KHONG dong goi nua — tai theo nhu cau tu Google Drive cua du an. -->
  <ItemGroup>
    <Content Include="..\OnlineLibrary\**\*.png">
      <Link>OnlineLibrary\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- Thu muc Library (21 GIF) nam canh exe sau khi publish, giong v3.1 -->
  <ItemGroup>
    <Content Include="..\Library\**\*.gif">
      <Link>Library\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\Library\**\*.md">
      <Link>Library\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
