<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TienKeyboardStudio3.MainWindow"
        Title="Tien Vu Keyboard Studio"
        Icon="/Assets/logo.png"
        Width="1180" Height="740"
        MinWidth="1040" MinHeight="640"
        Background="#0B0B10"
        FontFamily="avares://TienKeyboardStudio/Assets/Fonts#Be Vietnam Pro">
  <Grid>
    <!-- NEN APP: gradient phang mac dinh; khi chon skin/anh nen thi anh hien o day,
         phia tren co lop phu toi nhe de panel kinh va chu luon doc duoc.
         v3.11 (AULA-style, Preview v0.11.3 da duyet): lop phu giam nhe hon de hinh
         nen xuyen qua panel kinh ro ret; them BackdropAnimImage cho NEN DONG
         (GIF vong lap tu video ngan) nam giua anh tinh va lop phu. -->
    <Grid>
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#12121A" Offset="0" />
            <GradientStop Color="#0B0B10" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Image x:Name="BackdropImage" Stretch="UniformToFill" IsVisible="False" />
      <Image x:Name="BackdropAnimImage" Stretch="UniformToFill" IsVisible="False" />
      <Border x:Name="BackdropShade" IsVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#330B0B10" Offset="0" />
            <GradientStop Color="#730B0B10" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Grid>

    <Grid RowDefinitions="Auto,*">
      <!-- THANH TREN CUNG (v3.11, kieu AULA Hub): logo + ten app ben trai;
           ben phai: 5 cham mau chu de, nut Sang/Toi, nut Cai dat -->
      <Border Grid.Row="0" Background="{StaticResource PanelTintBrush}" BorderBrush="#24FFFFFF" BorderThickness="0,0,0,1"
              Padding="16,9">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border CornerRadius="9" ClipToBounds="True" Width="30" Height="30">
              <Image Source="/Assets/logo.png" Width="30" Height="30" />
            </Border>
            <TextBlock Text="Tien Vu Keyboard Studio" FontSize="14" FontWeight="Bold" Foreground="#F4F4F8"
                       VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <StackPanel x:Name="TopAccentRow" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center" Margin="0,0,4,0" />
            <Button x:Name="TopThemeBtn" Classes="topicon" ToolTip.Tip="Chế độ Sáng / Tối">
              <Path x:Name="TopThemeIcon" Width="16" Height="16" Stretch="Uniform"
                    Stroke="#F4F4F8" StrokeThickness="1.7"
                    Data="M20 13.2A8.5 8.5 0 1 1 10.8 4 6.8 6.8 0 0 0 20 13.2Z" />
            </Button>
            <Button x:Name="TopSettingsBtn" Classes="topicon" ToolTip.Tip="Cài đặt">
              <Path Width="16" Height="16" Stretch="Uniform"
                    Stroke="#F4F4F8" StrokeThickness="1.7"
                    Data="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 1.55V21a2 2 0 1 1-4 0v-.09A1.7 1.7 0 0 0 9 19.4a1.7 1.7 0 0 0-1 1.55V21a2 2 0 1 1-4 0v-.09A1.7 1.7 0 0 0 9 19.4a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.55-1H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.34-1.87l-.06-.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.55V3a2 2 0 1 1 4 0v.09a1.7 1.7 0 0 0 1 1.51 1.7 1.7 0 0 0 1.87-.34l.06-.06A1.7 1.7 0 1 0 19.4 9c.24.6.86 1 1.51 1H21a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.51 1Z" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="250,*" Margin="14">
      <!-- SIDEBAR: panel kinh noi tach khoi nen (Liquid Glass: highlight mep tren) -->
      <Border Grid.Column="0" CornerRadius="26" Background="{StaticResource PanelTintBrush}"
              BorderBrush="#30FFFFFF" BorderThickness="1"
              BoxShadow="inset 0 1 0 0 #38FFFFFF, inset 0 -1 0 0 #0D000000, 0 12 30 0 #59000000" Padding="14" Margin="0,0,10,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <Border CornerRadius="11" ClipToBounds="True" Width="42" Height="42">
                <Image Source="/Assets/logo.png" Width="42" Height="42" />
              </Border>
              <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="Tien Vu" FontSize="15.5" FontWeight="Bold" Foreground="#F4F4F8" />
                <TextBlock Text="Keyboard Studio" FontSize="10.5" Foreground="#8B88A0" />
              </StackPanel>
            </StackPanel>
            <Border Height="1" Background="#14FFFFFF" Margin="2,14,2,10" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Spacing="10">
            <StackPanel x:Name="SideSettingsHost" Spacing="1" />
            <TextBlock Text="Tien Vu Keyboard Studio · v3.17.0" FontSize="10.5" Foreground="#6F6C84"
                       HorizontalAlignment="Center" />
          </StackPanel>

          <!-- v3.11.1: danh sach dieu huong nam trong ScrollViewer — cua so
               thap thi danh sach CUON, khong con de len khoi day nhu ban
               3.11.0 (anh Tien gui). -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="NavPanel" Spacing="1" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Vung noi dung trang -->
      <Grid Grid.Column="1" x:Name="PageHost" Margin="8,2,2,2" />
      </Grid>
    </Grid>

    <!-- PANEL CAI DAT (v3.11, kieu AULA Hub — Preview v0.11.3 da duyet): phu len
         toan bo app (app chinh mo phia sau), co MINI-SIDEBAR rieng: nut pill
         "Quay lai" + cac muc Cai dat chung / Giao dien chu de / GameSense /
         Phan hoi / Gioi thieu. Noi dung dung tu code (BuildSettingsOverlay) —
         toan bo la cai dat THAT cua app. -->
    <Grid x:Name="SettingsOverlay" IsVisible="False" Opacity="0">
      <Border x:Name="SettingsDim" Background="#D10A0A12" />
      <Grid ColumnDefinitions="264,*" Margin="14">
        <Border Grid.Column="0" CornerRadius="26" Background="{StaticResource SettingsPanelBrush}"
                BorderBrush="#30FFFFFF" BorderThickness="1"
                BoxShadow="inset 0 1 0 0 #38FFFFFF, inset 0 -1 0 0 #0D000000, 0 12 30 0 #59000000"
                Padding="14" Margin="0,0,10,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="10">
              <Button x:Name="SettingsBackBtn" Classes="ghost" HorizontalAlignment="Left" Padding="16,8">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Path Width="14" Height="14" Stretch="Uniform" Stroke="#F4F4F8" StrokeThickness="1.8"
                        Data="M9 14 4 9l5-5 M4 9h11" VerticalAlignment="Center" />
                  <TextBlock Text="Quay lại" FontSize="13" Foreground="#F4F4F8" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Height="1" Background="#14FFFFFF" Margin="2,2,2,4" />
            </StackPanel>
            <StackPanel x:Name="SettingsNavPanel" Spacing="1" />
          </DockPanel>
        </Border>
        <Border Grid.Column="1" CornerRadius="26" Background="{StaticResource SettingsContentBrush}"
                BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="16,10,10,10" Margin="8,2,2,2">
          <Grid RowDefinitions="Auto,*">
            <TextBlock x:Name="SettingsTitle" Grid.Row="0" Text="Cài đặt chung" FontSize="22" FontWeight="Bold"
                       Foreground="#F4F4F8" Margin="2,4,0,10" />
            <Grid x:Name="SettingsHost" Grid.Row="1" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- MODAL CHI TIET PLUGIN: nen mo + panel kinh o giua man hinh,
         noi dung panel dung tu code (OpenPluginModal) -->
    <Grid x:Name="PluginModal" IsVisible="False" Opacity="0">
      <Border x:Name="PluginModalDim" Background="#D10A0A12" />
      <Panel x:Name="PluginModalHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" />
    </Grid>

    <!-- CHU KY TAC GIA (v3.8): dong nho mo o goc duoi phai, luon hien -->
    <TextBlock Text="cre tiendz2k" FontSize="10" Foreground="#40FFFFFF"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,10,6" IsHitTestVisible="False" />

    <!-- TOAST kinh mo -->
    <Border x:Name="Toast" Classes="toastcard" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,26,24" MaxWidth="440" IsVisible="False" Opacity="0" IsHitTestVisible="False">
      <TextBlock x:Name="ToastText" TextWrapping="Wrap" FontSize="12.5" Foreground="#F4F4F8" />
    </Border>

    <!-- MAN HINH CHAO: logo Mau F + than hieu ung theo phong cach dang chon
         (dung tu code), bam/Esc de bo qua -->
    <Border x:Name="GreetingOverlay" Background="#F20A0A12" IsVisible="False" Opacity="0">
      <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" Width="560">
          <Border CornerRadius="20" ClipToBounds="True" Width="92" Height="92"
                  HorizontalAlignment="Center"
                  BoxShadow="0 0 44 0 #667C3AED">
            <Image Source="/Assets/logo.png" Width="92" Height="92" />
          </Border>
          <TextBlock Text="Tien Vu Keyboard Studio" FontSize="27" FontWeight="Bold" Foreground="#F4F4F8"
                     HorizontalAlignment="Center" LetterSpacing="0.3" />
          <TextBlock x:Name="GreetingSub" Text="Chào mừng bạn trở lại" FontSize="13.5" Foreground="#A6A3B8"
                     HorizontalAlignment="Center" />
          <Panel x:Name="GreetingBodyHost" Height="118" Margin="10,2,10,0" />
          <TextBlock x:Name="GreetingStatus" Text="Đang nạp giao diện…" FontSize="11.5"
                     Foreground="#6F6C84" HorizontalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="Bấm vào màn hình hoặc nhấn Esc để bỏ qua" FontSize="11" Foreground="#57546E"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" />
      </Grid>
    </Border>
  </Grid>
</Window>
