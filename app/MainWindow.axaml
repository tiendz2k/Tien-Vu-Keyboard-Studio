<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TienKeyboardStudio3.MainWindow"
        Title="T Keyboard Studio"
        Icon="/Assets/logo.png"
        Width="1180" Height="740"
        MinWidth="1040" MinHeight="640"
        Background="#0B0B10"
        FontFamily="avares://TienKeyboardStudio/Assets/Fonts#Be Vietnam Pro">
  <Grid>
    <!-- NEN APP: gradient phang mac dinh; khi chon skin/anh nen thi anh hien o day,
         phia tren co lop phu toi nhe de panel kinh va chu luon doc duoc (v3.3) -->
    <Grid>
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#12121A" Offset="0" />
            <GradientStop Color="#0B0B10" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Image x:Name="BackdropImage" Stretch="UniformToFill" IsVisible="False" />
      <Border x:Name="BackdropShade" IsVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#590B0B10" Offset="0" />
            <GradientStop Color="#A60B0B10" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Grid>

    <Grid ColumnDefinitions="250,*" Margin="14">
      <!-- SIDEBAR: panel kinh noi tach khoi nen (Liquid Glass: highlight mep tren) -->
      <Border Grid.Column="0" CornerRadius="20" Background="#17FFFFFF"
              BorderBrush="#2BFFFFFF" BorderThickness="1"
              BoxShadow="inset 0 1 0 0 #38FFFFFF, inset 0 -1 0 0 #0D000000, 0 12 30 0 #59000000" Padding="14" Margin="0,0,10,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <Border CornerRadius="11" ClipToBounds="True" Width="42" Height="42">
                <Image Source="/Assets/logo.png" Width="42" Height="42" />
              </Border>
              <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="T Keyboard" FontSize="15.5" FontWeight="Bold" Foreground="#F4F4F8" />
                <TextBlock Text="Tien Keyboard Studio" FontSize="10.5" Foreground="#8B88A0" />
              </StackPanel>
            </StackPanel>
            <Border Height="1" Background="#14FFFFFF" Margin="2,14,2,10" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Spacing="10">
            <Border Classes="cardflat">
              <StackPanel Spacing="5">
                <TextBlock x:Name="DryTitle" Text="Dry-run đang bật" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" />
                <TextBlock x:Name="DryDesc" Text="Chế độ an toàn: thao tác chỉ ghi log, không ghi xuống phím thật."
                           FontSize="10.5" Foreground="#A6A3B8" TextWrapping="Wrap" />
                <ToggleSwitch x:Name="DryToggle" IsChecked="True" OnContent="Dry-run: BẬT" OffContent="Dry-run: TẮT"
                              FontSize="11.5" Foreground="#E7EAF2" />
              </StackPanel>
            </Border>
            <TextBlock Text="T Keyboard Studio · v3.4.0" FontSize="10.5" Foreground="#6F6C84"
                       HorizontalAlignment="Center" />
          </StackPanel>

          <StackPanel x:Name="NavPanel" Spacing="1" />
        </DockPanel>
      </Border>

      <!-- Vung noi dung trang -->
      <Grid Grid.Column="1" x:Name="PageHost" Margin="8,2,2,2" />
    </Grid>

    <!-- MODAL CHI TIET PLUGIN (v3.3): nen mo + panel kinh o giua man hinh,
         noi dung panel dung tu code (OpenPluginModal) -->
    <Grid x:Name="PluginModal" IsVisible="False" Opacity="0">
      <Border x:Name="PluginModalDim" Background="#B30A0A12" />
      <Panel x:Name="PluginModalHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" />
    </Grid>

    <!-- TOAST kinh mo -->
    <Border x:Name="Toast" Classes="toastcard" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,26,24" MaxWidth="440" IsVisible="False" Opacity="0" IsHitTestVisible="False">
      <TextBlock x:Name="ToastText" TextWrapping="Wrap" FontSize="12.5" Foreground="#F4F4F8" />
    </Border>

    <!-- MAN HINH CHAO (v3.3): logo Mau C + than hieu ung theo phong cach dang chon
         (galaxy / terminal / 550C — dung tu code), ~2 giay, bam/Esc de bo qua -->
    <Border x:Name="GreetingOverlay" Background="#F20A0A12" IsVisible="False" Opacity="0">
      <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" Width="560">
          <Border CornerRadius="20" ClipToBounds="True" Width="92" Height="92"
                  HorizontalAlignment="Center"
                  BoxShadow="0 0 44 0 #667C3AED">
            <Image Source="/Assets/logo.png" Width="92" Height="92" />
          </Border>
          <TextBlock Text="T Keyboard Studio" FontSize="27" FontWeight="Bold" Foreground="#F4F4F8"
                     HorizontalAlignment="Center" LetterSpacing="0.3" />
          <TextBlock x:Name="GreetingSub" Text="Chào mừng bạn trở lại" FontSize="13.5" Foreground="#A6A3B8"
                     HorizontalAlignment="Center" />
          <Panel x:Name="GreetingBodyHost" Height="118" Margin="10,2,10,0" />
          <TextBlock x:Name="GreetingStatus" Text="Đang nạp giao diện…" FontSize="11.5"
                     Foreground="#6F6C84" HorizontalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="Bấm vào màn hình hoặc nhấn Esc để bỏ qua" FontSize="11" Foreground="#57546E"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" />
      </Grid>
    </Border>
  </Grid>
</Window>
